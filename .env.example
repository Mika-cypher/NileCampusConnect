# .env.example
# Copy to .env for local development. Never commit .env.

# Django secret key — generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to True only for local dev. Always False on Render.
DEBUG=True

# Comma-separated. Add your Render URL once you have it.
# e.g. nilecampusconnect.onrender.com,localhost
ALLOWED_HOSTS=localhost,127.0.0.1

# Render injects this automatically when a PostgreSQL DB is attached.
# Leave blank locally to use SQLite.
DATABASE_URL=

# Paystack test key for local dev. Swap for live key in Render dashboard.
PAYSTACK_PUBLIC_KEY=pk_test_YOUR_KEY_HERE